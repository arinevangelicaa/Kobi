# Salin berkas ini menjadi .env.local untuk pengembangan lokal.
# Jangan pernah commit nilai aslinya. Di produksi, isi lewat Application
# Settings App Service atau Azure Key Vault.

# Basis data
DATABASE_URL="postgresql://kobi:kobi@localhost:5432/kobi?schema=public"

# Batas koneksi pool Postgres per instance App Service (bilangan bulat >= 1).
# Kosong = 5. Total koneksi = DATABASE_POOL_MAX x jumlah instance, jaga di
# bawah batas max_connections server.
# Produksi: tambahkan ?sslmode=require pada DATABASE_URL.
DATABASE_POOL_MAX=""

# Auth.js
AUTH_SECRET=""
AUTH_GOOGLE_ID=""            # opsional, belum diimplementasi (Credentials saja untuk saat ini)
AUTH_GOOGLE_SECRET=""

# Azure OpenAI (Microsoft Foundry)
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT=""

# Azure Maps
AZURE_MAPS_KEY=""

# Azure AI Document Intelligence (S1, stretch)
AZURE_DOCINTEL_ENDPOINT=""
AZURE_DOCINTEL_KEY=""

# Azure Blob Storage (S1, stretch)
AZURE_STORAGE_CONNECTION_STRING=""

# Application Insights (opsional). Kosong = telemetri nonaktif. Bila diisi,
# instrumentation.ts hanya mencatat peringatan karena paket
# @azure/monitor-opentelemetry belum terpasang.
APPLICATIONINSIGHTS_CONNECTION_STRING=""
