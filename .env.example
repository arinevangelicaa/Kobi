# Salin berkas ini menjadi .env.local untuk pengembangan lokal.
# Jangan pernah commit nilai aslinya. Di produksi, isi lewat Application
# Settings App Service atau Azure Key Vault.

# Basis data
DATABASE_URL="postgresql://kobi:kobi@localhost:5432/kobi?schema=public"

# Auth.js
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Azure OpenAI (Microsoft Foundry)
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT=""

# Azure Maps
AZURE_MAPS_KEY=""

# Azure AI Document Intelligence (S1, stretch)
AZURE_DOCINTEL_ENDPOINT=""
AZURE_DOCINTEL_KEY=""

# Azure Blob Storage (S1, stretch)
AZURE_STORAGE_CONNECTION_STRING=""
